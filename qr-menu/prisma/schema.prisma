generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String?
  createdAt    DateTime     @default(now())
  restaurants  Restaurant[]
}

model Restaurant {
  id                String     @id @default(cuid())
  slug              String     @unique
  name              String
  description       String?
  address           String?
  logoUrl           String?
  coverUrl          String?
  primaryColor      String     @default("#0F172A")
  theme             String     @default("modern")
  currency          String     @default("RUB")
  telegramChatId    String?
  googleMapsUrl     String?
  instagramUrl      String?
  whatsappPhone     String?
  bookingMessage    String?
  mainMenuPdfUrl    String?
  specialMenuPdfUrl String?
  isPublished       Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  ownerId         String
  owner           User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  categories      Category[]
  dishes          Dish[]
  tables          Table[]
  orders          Order[]
  offerings       Offering[]
  events          Event[]
  highlights      Highlight[]
  instagramPosts  InstagramPost[]

  @@index([ownerId])
}

model Category {
  id           String     @id @default(cuid())
  name         String
  sort         Int        @default(0)
  createdAt    DateTime   @default(now())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dishes       Dish[]

  @@index([restaurantId])
}

model Dish {
  id           String     @id @default(cuid())
  name         String
  description  String?
  price        Int
  photoUrl     String?
  isAvailable  Boolean    @default(true)
  sort         Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  orderItems   OrderItem[]

  @@index([categoryId])
  @@index([restaurantId])
}

model Table {
  id           String     @id @default(cuid())
  label        String
  qrToken      String     @unique @default(cuid())
  createdAt    DateTime   @default(now())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([restaurantId])
}

model Order {
  id            String      @id @default(cuid())
  status        String      @default("new")
  total         Int
  customerName  String?
  customerPhone String?
  note          String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  restaurantId  String
  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  tableId       String?
  table         Table?      @relation(fields: [tableId], references: [id], onDelete: SetNull)

  items         OrderItem[]

  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
}

model OrderItem {
  id           String   @id @default(cuid())
  dishName     String
  priceAtOrder Int
  quantity     Int

  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  dishId       String?
  dish         Dish?    @relation(fields: [dishId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Highlight {
  id           String     @id @default(cuid())
  name         String
  description  String?
  photoUrl     String?
  instagramUrl String?
  sort         Int        @default(0)
  createdAt    DateTime   @default(now())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model Event {
  id            String     @id @default(cuid())
  title         String
  description   String?
  whenText      String
  photoUrl      String?
  whatsappTopic String?
  sort          Int        @default(0)
  createdAt     DateTime   @default(now())

  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model Offering {
  id            String     @id @default(cuid())
  title         String
  description   String?
  photoUrl      String?
  whatsappTopic String?
  sort          Int        @default(0)
  createdAt     DateTime   @default(now())

  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

model InstagramPost {
  id           String     @id @default(cuid())
  url          String
  sort         Int        @default(0)
  createdAt    DateTime   @default(now())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}
